NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Read-only synthetic fixtures. Refused in production. Never authorizes restaurant access.
DEMO_MODE=false
# Blank: API runs, readiness returns 503. Use Neon pooled URL for application traffic.
DATABASE_URL=
# Neon direct (non-pooler) URL for migrations/seeding. Include sslmode=verify-full.
DIRECT_URL=
# Explicit opt-in for synthetic DRAFT seed only. No working passwords or live QRs are seeded.
ALLOW_DEMO_SEED=false
# Neon Realtime variables are not used; Socket.IO remains the selected transport.
# DATABASE_URL_POOLED is not a RestroDock setting: use DATABASE_URL and DIRECT_URL above.
# Do not activate real tenants before staff auth and later UAT gates pass.

# Used ONLY on first startup of a fresh database; never resets an existing account.
# Choose your private operator email and a unique 15–128 character password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 64 hex characters. Development predev generates/preserves this if blank.
# Production: provision a stable random secret, back it up, never expose NEXT_PUBLIC.
GUEST_PII_KEY=

# Optional second exact origin for local LAN access. Development only.
# DEV_CLIENT_ORIGIN=http://192.168.1.10:3000
# Enables the QR checkout pilot in development. Keep false in production.
CHECKOUT_PILOT_ENABLED=false

# Optional password recovery. Use a Brevo API key and a verified sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Number of trusted reverse-proxy hops in front of this API (0-3). Default 0 = ignore X-Forwarded-For.
# Behind the Next same-origin proxy every visitor otherwise shares one rate-limit bucket. Set 1 ONLY when an ingress you
# control (nginx, Render, Fly, Vercel...) appends/overwrites X-Forwarded-For, and set API_PROXY_FORWARD_CLIENT_IP=true in client/.env.
TRUST_PROXY_HOPS=0
