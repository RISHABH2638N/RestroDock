# Same-origin API proxy by default. The server stays a separate process.
API_PROXY_URL=http://127.0.0.1:4000
# Optional direct public API origin for split-host deployments; leave blank locally.
NEXT_PUBLIC_API_URL=

# Enables local synthetic UI wireframes only in development/test. Production always refuses them.
ENABLE_UX_PREVIEW=true

# Forward the ingress-provided X-Forwarded-For to the API so rate limits apply per visitor. Leave false unless the app
# sits behind an ingress you control AND the API has TRUST_PROXY_HOPS set to match. Never enable when Next is internet-facing.
API_PROXY_FORWARD_CLIENT_IP=false

# Enable on the public restrodock.com production deployment after verifying HTTPS.
# Preview and private routes stay noindex.
RESTRODOCK_PUBLIC_INDEXING=false
